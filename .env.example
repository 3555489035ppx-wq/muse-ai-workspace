# Muse AI BFF only. Never prefix secrets with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=max
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
MUSE_AI_LIVE_ENABLED=false
MUSE_AI_KILL_SWITCH=true
MUSE_AI_ACTOR_ID=muse-local-experiment
MUSE_AI_ALLOWED_PROJECT_IDS=
MUSE_AI_REQUEST_BUDGET_CNY=1
MUSE_AI_PROJECT_DAILY_BUDGET_CNY=10
MUSE_RUNTIME_DIRECTORY=.muse-runtime
# Optional 32-byte hex/base64 key for deployments. Local development creates a 0600 key file on first save.
MUSE_SECRET_STORE_KEY=
