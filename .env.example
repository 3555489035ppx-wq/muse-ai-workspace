# Muse AI BFF only. Never prefix secrets with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=max
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
MUSE_AI_LIVE_ENABLED=false
MUSE_AI_KILL_SWITCH=true
MUSE_AI_ACTOR_ID=muse-local-experiment
MUSE_AI_ALLOWED_PROJECT_IDS=
MUSE_AI_REQUEST_BUDGET_CNY=1
MUSE_AI_PROJECT_DAILY_BUDGET_CNY=10
MUSE_RUNTIME_DIRECTORY=.muse-runtime
# Optional 32-byte hex/base64 key for deployments. Local development creates a 0600 key file on first save.
MUSE_SECRET_STORE_KEY=

# Vercel / Worker hosted AI. These stay server-side: do not use a VITE_ prefix
# and never expose them in client code. With these values set, visitors can use
# Muse's Text AI without supplying their own API key.
MUSE_SITE_TEXT_PROVIDER=openai
MUSE_SITE_TEXT_DISPLAY_NAME=Muse Text AI
MUSE_SITE_TEXT_API_KEY=
MUSE_SITE_TEXT_BASE_URL=https://api.openai.com/v1
MUSE_SITE_TEXT_MODEL=gpt-5.2

# Optional server-managed Web Search for the Research Assistant. Keep this
# secret server-side; never use a VITE_ prefix. Search results remain candidate
# sources until the user opens the original page and confirms the excerpt.
MUSE_SITE_SEARCH_PROVIDER=tavily
MUSE_SITE_SEARCH_API_KEY=
MUSE_SITE_SEARCH_BASE_URL=https://api.tavily.com
MUSE_SITE_SEARCH_MAX_RESULTS=5
